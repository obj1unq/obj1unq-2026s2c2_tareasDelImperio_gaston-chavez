import imperio.*
import habitantes.*
import comunidades.*

describe "Imperio Inca" {
  //PUNTO 1 
  const siembraDePapa = new Valle(esfuerzo = 1.2)
  const siembraDeMaiz = new Terrazas(esfuerzo = 1.5)

  const rutaTamboCentral = new Mensaje()
  const caminoDelSapaInca = new MensajeImperial()

  //PUNTO 2
  const cusi = new Campesino(energia = 100, tiempo = 4)
  const tupac = new Elite(energia = 200)

  //PUNTO 3
  const colcaAgricola = new Colca(tareas = #{siembraDePapa, siembraDeMaiz})
  const colcaCentral = new Colca(tareas = #{rutaTamboCentral, caminoDelSapaInca})
  const aylluReal = new Ayllu(colcas = #{colcaAgricola, colcaCentral})
 
  test "Tareas de siembra" {
    siembraDePapa.estacionDelAño(epocaSequia)
    assert.equals(180, siembraDePapa.recursosProducidos(4))
    assert.equals(420, siembraDePapa.recursosProducidos(10))

    assert.equals(900, siembraDeMaiz.recursosProducidos(5))
    assert.equals(1125, siembraDeMaiz.recursosProducidos(7))
  }

  test "Tareas de mensajeria" {
    assert.equals(210, rutaTamboCentral.recursosProducidos(4))
    assert.equals(525, rutaTamboCentral.recursosProducidos(10))

    assert.equals(270, caminoDelSapaInca.recursosProducidos(4))
    assert.equals(810, caminoDelSapaInca.recursosProducidos(10))
  }

  test "cusi sembrando papa" {
    siembraDePapa.estacionDelAño(epocaSequia)
    cusi.aplicarTarea(siembraDePapa)
    assert.equals(82, cusi.energia())
  }

  test "cusi mensajero" {
    cusi.aplicarTarea(rutaTamboCentral)
    assert.equals(79, cusi.energia())
  }

  test "Cusi no puede realizar tareas" {
    siembraDePapa.estacionDelAño(epocaSequia)
    cusi.energia(15)
    assert.throwsException({cusi.aplicarTarea(siembraDePapa)})
    assert.throwsException({cusi.aplicarTarea(rutaTamboCentral)})
    assert.equals(15, cusi.energia())
  }

  test "tupac sembrando maiz" {
    tupac.aplicarTarea(siembraDeMaiz)
    assert.equals(111.25, tupac.energia())
  }

  test "tupac mensajero" {
    tupac.aplicarTarea(caminoDelSapaInca)
    assert.equals(137.5, tupac.energia())
  }

  test "Comunidades" {
    siembraDePapa.estacionDelAño(epocaSequia)
    
    assert.equals(colcaAgricola, aylluReal.laMejorColcaPara(tupac))
    assert.equals(colcaAgricola, aylluReal.laMejorColcaPara(cusi))

    assert.equals(#{}, aylluReal.colcasSuavesPara(tupac))
    assert.equals(#{colcaAgricola}, aylluReal.colcasSuavesPara(cusi))

    assert.equals([siembraDeMaiz, caminoDelSapaInca], aylluReal.tareaMasExigentePara(tupac))
    assert.equals([siembraDeMaiz, caminoDelSapaInca], aylluReal.tareaMasExigentePara(cusi))
  }
}